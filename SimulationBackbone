💻 Example simulation

A simplified mrgsolve workflow may look like:

library(mrgsolve)
library(dplyr)
library(ggplot2)

mod <- mread(
  "model_name",
  "path/to/model"
)

dose <- ev(
  time = 0,
  amt  = 10,
  cmt  = 1
)

sim <- mod |>
  ev(dose) |>
  mrgsim(
    end   = 48,
    delta = 0.1
  ) |>
  as_tibble()

ggplot(sim, aes(time, CP)) +
  geom_line() +
  labs(
    x = "Time",
    y = "Concentration",
    title = "Simulated concentration–time profile"
  )

